---
import { Phone } from "@lucide/astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ImageSlot from "@/components/ImageSlot.astro";
import { BUSINESS } from "@/lib/business";
import { SERVICE_CATEGORY_LABELS } from "@/lib/data/services/catalog";
import type { Service } from "@/lib/data/types";

interface Props { service: Service }
const { service } = Astro.props;
const shot = service.heroShot ?? `${service.shortName} in a Las Vegas home, crew at work`;
---

<section class="dark band-ink" aria-labelledby="service-heading">
  <div class="container mx-auto px-4 pt-24 pb-14 md:pt-36 md:pb-20">
    <Breadcrumbs
      tone="dark"
      items={[
        { label: "Home", href: "/" },
        { label: "Services", href: "/services" },
        { label: service.shortName, href: `/services/${service.slug}` },
      ]}
    />
    <div class="mt-8 grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <p class="eyebrow">{SERVICE_CATEGORY_LABELS[service.category]}</p>
        <h1 id="service-heading" class="mt-4 max-w-2xl text-5xl leading-[0.95] tracking-wide text-white md:text-6xl">
          {service.name}
        </h1>
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-white/75 md:text-xl">{service.tagline}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-lg bg-white px-6 font-heading text-base font-bold uppercase tracking-wide text-ink transition-[background-color,transform] duration-150 ease-out hover:bg-cream focus-visible:ring-3 focus-visible:ring-white/40 focus-visible:outline-none active:scale-[0.96]">
            Contact us
          </a>
          <a href={`tel:${BUSINESS.phone.e164}`} class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-white/25 px-6 font-heading text-base font-bold uppercase tracking-wide text-white transition-[background-color,transform] duration-150 ease-out hover:bg-white/10 focus-visible:ring-3 focus-visible:ring-white/40 focus-visible:outline-none active:scale-[0.96]">
            <Phone class="size-4" aria-hidden="true" />
            {BUSINESS.phone.display}
          </a>
        </div>
      </div>
      <ImageSlot image={service.heroImage} shot={shot} aspect="4/3" priority sizes="(min-width: 1024px) 45vw, 100vw" />
    </div>
  </div>
</section>
