---
import SectionHeading from "@/components/SectionHeading.astro";
import ImageSlot from "@/components/ImageSlot.astro";
import type { StaticImage } from "@/lib/data/types";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  steps: Array<{ title: string; description: string; image?: StaticImage }>;
  id?: string;
  class?: string;
  /** Show a photo frame above each step. */
  photos?: boolean;
  /** Prefix for placeholder labels, e.g. the service name. */
  shotPrefix?: string;
}

const { eyebrow = "How it works", title, lead, steps, id = "steps-heading", class: className = "band-cream", photos = false, shotPrefix = "" } = Astro.props;
---

<section class:list={["section", className]} aria-labelledby={id}>
  <div class="container mx-auto px-4">
    <SectionHeading id={id} eyebrow={eyebrow} title={title} lead={lead} />
    <ol class="mt-10 grid gap-x-8 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="flex min-w-0 flex-col gap-4 border-t border-black/10 pt-5">
          {photos && <ImageSlot image={step.image} shot={`${shotPrefix ? `${shotPrefix}: ` : ""}${step.title.toLowerCase()}`} aspect="16/10" class="rounded-xl" sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" />}
          <div class="flex gap-4">
          <span class="font-heading text-3xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="font-heading text-xl leading-tight font-bold uppercase tracking-wide text-ink">
              <span class="sr-only">Step {i + 1}: </span>{step.title}
            </h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-body">{step.description}</p>
          </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
