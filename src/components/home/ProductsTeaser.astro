---
import { ArrowRight } from "@lucide/astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { categories } from "@/lib/data/categories";

const sorted = [...categories].sort((a, b) => a.order - b.order);
---

<section class="section band-cream" aria-labelledby="products-heading">
  <div class="container mx-auto px-4">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        id="products-heading"
        eyebrow="Materials"
        title="Pick from what we install"
        lead="Browse the flooring, fixtures, paint, and hardware we work with most, then let us quote the install."
      />
      <a href="/products" class="inline-flex shrink-0 items-center gap-1.5 text-[0.95rem] font-medium text-ink underline decoration-ink/25 underline-offset-4 transition-colors hover:decoration-brand-red">
        Browse products
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </div>
    <ul class="mt-10 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
      {sorted.map((c) => (
        <li class="border-t border-black/10">
          <a href={`/products/category/${c.slug}`} class="group flex items-start justify-between gap-4 py-4 transition-colors hover:text-brand-red focus-visible:ring-3 focus-visible:ring-ink/20 focus-visible:outline-none">
            <span>
              <span class="block font-heading text-lg leading-tight font-bold uppercase tracking-wide text-ink group-hover:text-brand-red">{c.label}</span>
              <span class="mt-1 block text-sm leading-snug text-body">{c.description}</span>
            </span>
            <ArrowRight class="mt-1 size-4 shrink-0 text-body transition-transform duration-150 ease-out group-hover:translate-x-0.5 group-hover:text-brand-red" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
