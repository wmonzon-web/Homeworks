---
import SectionHeading from "@/components/SectionHeading.astro";

const steps = [
  {
    title: "Tell us the job",
    body: "Pick the service, drop in your ZIP and phone, and add photos if you have them. Under a minute, no account.",
  },
  {
    title: "Get a real number",
    body: "Repairs are usually a flat price from your photos. Bigger work gets a written scope after a quick walkthrough.",
  },
  {
    title: "Pick a day this week",
    body: "We schedule repairs within the week and lock renovation start dates in the quote, so there's no chasing.",
  },
  {
    title: "We do it and clean up",
    body: "One licensed crew, one point of contact, drop cloths down, and the house left the way we found it, only fixed.",
  },
];
---

<section class="section band-cream" aria-labelledby="process-heading">
  <div class="container mx-auto px-4">
    <SectionHeading
      id="process-heading"
      eyebrow="How it works"
      title="From “can you fix this?” to fixed, in four steps"
    />
    <ol class="mt-10 grid gap-x-8 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="flex gap-4 border-t border-black/10 pt-5">
          <span class="font-heading text-3xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="font-heading text-xl leading-tight font-bold uppercase tracking-wide text-ink">
              <span class="sr-only">Step {i + 1}: </span>{step.title}
            </h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
