---
import { Phone } from "@lucide/astro";
import { BUSINESS } from "@/lib/business";
import { NAV_LINKS, isActivePath } from "@/components/layout/nav";
import Wordmark from "@/components/layout/Wordmark.astro";
import MobileNav from "@/components/layout/MobileNav.tsx";

const currentPath = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-0 z-50 md:px-4 md:pt-3">
  <div
    class="mx-auto flex h-14 max-w-7xl items-center justify-between border-b border-black/8 bg-white/90 px-4 backdrop-blur-md md:h-16 md:rounded-full md:border md:px-6 md:shadow-[0_1px_2px_rgba(12,16,21,0.04),0_8px_24px_-12px_rgba(12,16,21,0.18)] supports-[backdrop-filter]:bg-white/80"
  >
    <a href="/" class="text-ink transition-opacity hover:opacity-80" aria-label={`${BUSINESS.name} home`}>
      <Wordmark size={30} />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const active = isActivePath(currentPath, link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative py-1 text-[0.95rem] font-medium transition-colors duration-150",
                active ? "text-ink" : "text-body hover:text-ink",
                "after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-brand-red after:transition-transform after:duration-150 after:ease-out",
                active ? "after:scale-x-100" : "after:scale-x-0 hover:after:scale-x-100",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href={`tel:${BUSINESS.phone.e164}`}
        class="hidden items-center gap-2 text-[0.95rem] font-medium text-ink transition-colors hover:text-brand-red lg:inline-flex"
      >
        <Phone class="size-4" aria-hidden="true" />
        <span>{BUSINESS.phone.display}</span>
      </a>
      <a
        href="/get-quote"
        class="hidden h-10 items-center rounded-full bg-ink px-5 font-heading text-[0.95rem] font-bold uppercase tracking-wide text-white transition-[background-color,transform] duration-150 ease-out hover:bg-ink-soft active:scale-[0.96] md:inline-flex"
      >
        Get a quote
      </a>
      <MobileNav client:media="(max-width: 767px)" currentPath={currentPath} />
    </div>
  </div>
</header>
