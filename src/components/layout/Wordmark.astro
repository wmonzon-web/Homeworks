---
import { BUSINESS } from "@/lib/business";

interface Props {
  class?: string;
  size?: number;
  full?: boolean;
  variant?: "dark" | "light";
}

const { class: className, size = 32, full = false, variant = "dark" } = Astro.props;
const src = full
  ? "/brand/lockup.svg"
  : variant === "light"
    ? "/brand/wordmark-light.svg"
    : "/brand/wordmark.svg";
---

<img
  src={src}
  alt={BUSINESS.name}
  width={full ? size * 3 : Math.round(size * 272 / 40)}
  height={size}
  class={className}
  decoding="async"
/>
