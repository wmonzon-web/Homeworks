---
/** Variant 1 — Dark & Direct. Axis: form-forward on an XBG-style ink hero. */
import { ShieldCheck, CalendarCheck, House } from "@lucide/astro";
import HeroLeadForm from "@/components/home/HeroLeadForm.astro";
import { BUSINESS } from "@/lib/business";

interface Props { showErrors?: boolean }
const { showErrors = false } = Astro.props;

const trust = [
  { Icon: ShieldCheck, label: "Licensed & insured" },
  { Icon: CalendarCheck, label: "Same-week scheduling" },
  { Icon: House, label: "One crew, every trade" },
];
---

<section class="dark band-ink relative overflow-hidden" aria-labelledby="hero-heading-dark">
  <!-- Stand-in for the hero photograph: real photo replaces this backdrop. -->
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background:
      radial-gradient(90% 70% at 85% 20%, oklch(0.32 0.03 60 / 0.55), transparent 60%),
      radial-gradient(60% 50% at 15% 90%, oklch(0.28 0.02 250 / 0.6), transparent 60%),
      linear-gradient(180deg, oklch(0.2 0.012 255), oklch(0.15 0.012 255));"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    aria-hidden="true"
    style="background-image: repeating-linear-gradient(135deg, white 0 1px, transparent 1px 22px);"
  ></div>

  <div class="container relative mx-auto px-4 pt-28 pb-16 md:pt-40 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="max-w-2xl">
        <p class="eyebrow">Las Vegas home services</p>
        <h1 id="hero-heading-dark" class="mt-4 text-5xl leading-[0.95] tracking-wide text-white md:text-6xl xl:text-7xl">
          Home repairs &amp; renovations, done right.
        </h1>
        <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-white/75 md:text-xl">
          Drywall, paint, flooring, plumbing, electrical, and the small jobs in
          between. One licensed crew for the house you already love, scheduled
          this week, not next month.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-3" aria-label="Why homeowners choose us">
          {trust.map(({ Icon, label }) => (
            <li class="inline-flex items-center gap-2 text-[0.95rem] font-medium text-white/85">
              <Icon class="size-4.5 text-brand-red" aria-hidden="true" />
              {label}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-white/55">
          Prefer to talk? <a href={`tel:${BUSINESS.phone.e164}`} class="font-medium text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">{BUSINESS.phone.display}</a>
        </p>
      </div>

      <div class="rounded-2xl bg-white p-6 text-ink shadow-floating md:p-8">
        <h2 class="font-heading text-2xl font-bold uppercase tracking-wide text-ink">Get a free quote</h2>
        <p class="mt-1 text-[0.95rem] text-body">Tell us the job and we'll follow up within one business day.</p>
        <div class="mt-6">
          <HeroLeadForm tone="card" showErrors={showErrors} idSuffix="dark" />
        </div>
      </div>
    </div>
  </div>
</section>
