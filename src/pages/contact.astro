---
import { Mail, MapPin, Phone } from "@lucide/astro";
import Base from "@/layouts/Base.astro";
import { BUSINESS } from "@/lib/business";

const areas = BUSINESS.serviceAreas.map((a) => a.city).join(", ");
---

<Base
  title="Contact"
  description={`Call or email ${BUSINESS.name}. Las Vegas home repairs and renovations, ${BUSINESS.hours.display[0].toLowerCase()}.`}
>
  <section class="section pt-6 md:pt-10">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl">
        <div>
          <p class="eyebrow">Contact</p>
          <h1 class="mt-3 text-4xl leading-[0.98] md:text-5xl">Talk to a person who can schedule it</h1>
          <p class="mt-4 max-w-[48ch] text-body">
            Call or email to discuss a repair, ask about a service, or plan your next project.
          </p>
          <dl class="mt-8 flex flex-col gap-5 border-t border-black/10 pt-6">
            <div class="flex items-start gap-3">
              <Phone class="mt-1 size-4.5 shrink-0 text-brand-red" aria-hidden="true" />
              <div>
                <dt class="text-sm text-body">Phone</dt>
                <dd><a href={`tel:${BUSINESS.phone.e164}`} class="font-medium text-ink hover:text-brand-red">{BUSINESS.phone.display}</a></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <Mail class="mt-1 size-4.5 shrink-0 text-brand-red" aria-hidden="true" />
              <div>
                <dt class="text-sm text-body">Email</dt>
                <dd><a href={`mailto:${BUSINESS.email}`} class="font-medium text-ink hover:text-brand-red">{BUSINESS.email}</a></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <MapPin class="mt-1 size-4.5 shrink-0 text-brand-red" aria-hidden="true" />
              <div>
                <dt class="text-sm text-body">Service area</dt>
                <dd class="text-ink">{areas}</dd>
              </div>
            </div>
          </dl>
          <div class="mt-6 border-t border-black/10 pt-6">
            <p class="text-sm text-body">Hours</p>
            <ul class="mt-1 text-ink">{BUSINESS.hours.display.map((h) => <li>{h}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
