---
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  steps: Array<{ title: string; description: string }>;
  id?: string;
  class?: string;
}

const { eyebrow = "How it works", title, lead, steps, id = "steps-heading", class: className = "band-cream" } = Astro.props;
---

<section class:list={["section", className]} aria-labelledby={id}>
  <div class="container mx-auto px-4">
    <SectionHeading id={id} eyebrow={eyebrow} title={title} lead={lead} />
    <ol class="mt-10 grid gap-x-8 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="flex gap-4 border-t border-black/10 pt-5">
          <span class="font-heading text-3xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="font-heading text-xl leading-tight font-bold uppercase tracking-wide text-ink">
              <span class="sr-only">Step {i + 1}: </span>{step.title}
            </h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-body">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
