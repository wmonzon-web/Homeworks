{
  "name": "homeworks",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply homeworks-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply homeworks-leads --remote",
    "deploy": "test ! -d src/pages/proto && astro build && wrangler deploy",
    "og": "node scripts/generate-og.mjs",
    "products:placeholders": "node scripts/generate-placeholder-products.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@lucide/astro": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.136.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "satori": "^0.33.4",
    "typescript": "^6.0.3"
  }
}
