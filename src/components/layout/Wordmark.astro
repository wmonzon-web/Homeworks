---
/**
 * Brand lockup: red house-H mark + "HOMEWORKS" set in the heading face.
 * The word is live text (not an SVG path) so it stays crisp, selectable, and
 * inherits `currentColor`; the mark is inline SVG so it needs no request.
 */
import { BUSINESS } from "@/lib/business";

interface Props {
  class?: string;
  /** Height of the mark in px; the word scales with it. */
  size?: number;
  /** Render only the mark (used in tight spaces). */
  markOnly?: boolean;
}

const { class: className, size = 32, markOnly = false } = Astro.props;
const wordSize = Math.round(size * 0.78);
---

<span class:list={["inline-flex items-center gap-2.5 leading-none", className]}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    width={size}
    height={size}
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="32" height="32" rx="7" class="fill-brand-red"></rect>
    <path d="M6.5 15.5 16 7l9.5 8.5" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M10.5 15v11M21.5 15v11" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
    <path d="M10.5 20.5h11" stroke="#fff" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  {!markOnly && (
    <span
      class="font-heading font-bold uppercase tracking-[0.08em] text-current"
      style={`font-size:${wordSize}px`}
    >
      {BUSINESS.name}
    </span>
  )}
</span>
