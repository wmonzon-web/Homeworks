---
import Base from "@/layouts/Base.astro";
import { Button } from "@/components/ui/button";
import { BUSINESS } from "@/lib/business";
import { getFeaturedServices } from "@/lib/data/services/catalog";

const featured = getFeaturedServices(4);
---

<Base title="We got it" description="Your message is in. Here's what happens next." noIndex skipGlobalSchema>
  <section class="section pt-6 md:pt-10">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl">
        <p class="eyebrow">Received</p>
        <h1 class="mt-3 text-5xl leading-[0.95] md:text-6xl">We got it. Here's what happens next.</h1>
        <ol class="mt-8 flex flex-col gap-4 border-t border-black/10 pt-6">
          <li class="flex gap-4">
            <span class="font-heading text-2xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">01</span>
            <p class="text-body"><span class="font-medium text-ink">Your request is saved.</span> We have the services and contact details you provided.</p>
          </li>
          <li class="flex gap-4">
            <span class="font-heading text-2xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">02</span>
            <p class="text-body"><span class="font-medium text-ink">We review the project details.</span> We may contact you to clarify the work or arrange a walkthrough.</p>
          </li>
          <li class="flex gap-4">
            <span class="font-heading text-2xl leading-none font-bold text-brand-red tabular-nums" aria-hidden="true">03</span>
            <p class="text-body"><span class="font-medium text-ink">We discuss the next step.</span> We can then scope the work and discuss scheduling.</p>
          </li>
        </ol>
        <p class="mt-8 text-body">
          Need it sooner? Call <a href={`tel:${BUSINESS.phone.e164}`} class="font-medium text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-brand-red">{BUSINESS.phone.display}</a>.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button asChild size="lg" variant="outline"><a href="/">Back to home</a></Button>
          <Button asChild size="lg" variant="ghost"><a href="/services">Browse services</a></Button>
        </div>
      </div>
      <div class="mt-16 border-t border-black/10 pt-8">
        <p class="text-sm text-body">While you wait, the jobs we get asked about most:</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {featured.map((s) => <li><a href={`/services/${s.slug}`} class="text-[0.95rem] font-medium text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-brand-red">{s.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
