---
import Base from "@/layouts/Base.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import ServiceCard from "@/components/services/ServiceCard.astro";
import Cta from "@/components/Cta.astro";
import { BUSINESS } from "@/lib/business";
import { SERVICE_CATALOG, SERVICE_CATEGORY_DESCRIPTIONS, getServicesByCategory } from "@/lib/data/services/catalog";
import { absoluteUrl, createBreadcrumbSchema } from "@/lib/seo";

const groups = getServicesByCategory();
const title = "Home repair & renovation services in Las Vegas";
const description = `${SERVICE_CATALOG.length} services for Las Vegas homeowners: drywall, painting, flooring, tile, plumbing, electrical, doors, kitchens, baths, and handyman repairs. One licensed crew, flat-price quotes.`;

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${BUSINESS.name} services`,
  itemListElement: SERVICE_CATALOG.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.name,
    url: absoluteUrl(`/services/${s.slug}`),
  })),
};
---

<Base title={title} description={description}>
  <section class="pt-6 pb-10 md:pt-8 md:pb-14">
    <div class="container mx-auto px-4">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Services", href: "/services" }]} />
      <div class="mt-8 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-16">
        <div>
          <p class="eyebrow">Services</p>
          <h1 class="mt-4 max-w-4xl text-5xl leading-[0.95] md:text-6xl">Everything your house needs, from one crew</h1>
        </div>
        <p class="max-w-[52ch] text-lg leading-relaxed text-body md:text-xl">
          Repairs are quoted flat from your photos and scheduled within the week.
          Renovations get a written scope and a start date. Pick the job below,
          or <a href="/contact" class="font-medium text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-brand-red">contact us</a> to discuss your project.
        </p>
      </div>
    </div>
  </section>

  <nav class="sticky top-14 z-30 border-y border-black/10 bg-white/90 backdrop-blur-md md:top-[4.75rem]" aria-label="Service categories" data-category-nav>
    <div class="container mx-auto px-4">
      <ul class="-mx-4 flex gap-1 overflow-x-auto px-4 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {groups.map((g) => (
          <li class="shrink-0">
            <a
              href={`#${g.category}`}
              data-category-link={g.category}
              class="inline-flex h-9 items-center rounded-lg px-3 text-sm font-medium whitespace-nowrap text-body transition-colors duration-150 hover:bg-cream hover:text-ink data-[active]:bg-ink data-[active]:text-white"
            >
              {g.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="container mx-auto px-4">
    {groups.map((group) => (
      <section id={group.category} class="scroll-mt-32 border-b border-black/10 py-12 last:border-b-0 md:py-16" aria-labelledby={`group-${group.category}`} data-category-section={group.category}>
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,2.15fr)] lg:gap-12">
          <div class="lg:sticky lg:top-40 lg:self-start">
            <p class="eyebrow">{String(group.services.length).padStart(2, "0")} {group.services.length === 1 ? "service" : "services"}</p>
            <h2 id={`group-${group.category}`} class="mt-3 text-3xl leading-[1.02] md:text-4xl">{group.label}</h2>
            <p class="mt-3 max-w-[38ch] text-[0.95rem] leading-relaxed text-body">{SERVICE_CATEGORY_DESCRIPTIONS[group.category]}</p>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {group.services.map((s) => <li><ServiceCard service={s} /></li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <Cta title="Don't see your job listed?" lead="If it's inside a house and it's broken, worn, or overdue for an update, send it our way and we'll tell you straight whether it's something we do." />

  <JsonLd data={listSchema} />
  <JsonLd data={createBreadcrumbSchema([{ name: "Home", path: "/" }, { name: "Services", path: "/services" }])} />
</Base>

<script>
  // Highlight the category in view. No animation: the nav just states where you are.
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-category-link]").forEach((a) => links.set(a.dataset.categoryLink!, a));
  const sections = [...document.querySelectorAll<HTMLElement>("[data-category-section]")];
  let active = "";
  const setActive = (id: string) => {
    if (id === active) return;
    active = id;
    links.forEach((a, key) => a.toggleAttribute("data-active", key === id));
    links.get(id)?.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "auto" });
  };
  const pick = () => {
    const line = window.innerHeight * 0.35;
    let current = sections[0];
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
    if (current) setActive(current.dataset.categorySection!);
  };
  pick();
  window.addEventListener("scroll", pick, { passive: true });
</script>
