---
/** Variant 2 — Cream Editorial. Axis: light, low density, oversized type, slim form bar. */
import HeroLeadForm from "@/components/home/HeroLeadForm.astro";
import { BUSINESS } from "@/lib/business";

interface Props { showErrors?: boolean }
const { showErrors = false } = Astro.props;
const areas = BUSINESS.serviceAreas.map((a) => a.city).join(", ");
---

<section class="band-cream" aria-labelledby="hero-heading-cream">
  <div class="container mx-auto px-4 pt-32 pb-14 md:pt-48 md:pb-24">
    <p class="eyebrow">Las Vegas · Licensed &amp; insured</p>
    <h1 id="hero-heading-cream" class="mt-5 max-w-[11ch] text-6xl leading-[0.9] tracking-normal text-ink md:text-8xl">
      Your home, handled.
    </h1>
    <p class="mt-7 max-w-[54ch] text-xl leading-relaxed text-body md:text-2xl md:leading-relaxed">
      Repairs, paint, floors, plumbing, and electrical from one crew that shows
      up when it says it will. For the house you're keeping, not flipping.
    </p>

    <div class="mt-12 rounded-2xl bg-white p-4 shadow-raised md:p-5">
      <HeroLeadForm tone="bar" showErrors={showErrors} idSuffix="cream" />
    </div>
    <p class="mt-4 text-sm text-body">
      Same-week scheduling · No-obligation quotes · Serving {areas}
    </p>
  </div>
</section>
