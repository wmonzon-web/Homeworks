{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeworks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeworks-leads",
      "database_id": "df3bb4e1-6d04-4e29-b221-ab14ec1cdcc5",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LEAD_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
