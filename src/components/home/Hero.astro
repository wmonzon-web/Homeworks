---
import { BUSINESS } from "@/lib/business";
import HeroLeadForm from "@/components/home/HeroLeadForm.astro";
import type { StaticImage } from "@/lib/data/types";

interface Props {
  /** Optional photograph behind the copy. Renders flat ink when absent. */
  image?: StaticImage;
}

const { image } = Astro.props;

const trust = ["Licensed & insured", "Same-week scheduling"];
---

<section class="dark band-ink relative isolate overflow-hidden" aria-labelledby="hero-heading" data-hero>
  <script is:inline>
    /* Decide before first paint whether the intro plays (once per session, never under reduced motion). */
    (function () {
      try {
        var plays = !sessionStorage.getItem("hw-intro") && !matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (plays) document.currentScript.parentElement.setAttribute("data-intro-pending", "");
      } catch (e) {}
    })();
  </script>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    {image ? (
      <img
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover outline-none"
      />
    ) : (
      <div class="h-full w-full bg-[oklch(0.3_0.01_255)]" style="background-image: linear-gradient(135deg, oklch(0.34 0.01 255) 0 1px, transparent 1px 28px)"></div>
    )}
    <div class="absolute inset-0 bg-[linear-gradient(90deg,oklch(0.17_0.012_255/0.94)_0%,oklch(0.17_0.012_255/0.82)_50%,oklch(0.17_0.012_255/0.6)_100%)]"></div>
    {!image && (
      <span class="absolute right-4 bottom-4 inline-flex items-center gap-2 rounded-md bg-white/10 px-2.5 py-1.5 text-xs text-white/70">Photo: crew finishing a wall in a Las Vegas living room, wide, natural light</span>
    )}
  </div>

  <div class="container mx-auto px-4 pt-28 pb-16 md:pt-40 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="max-w-2xl">
        <p class="eyebrow" data-intro>Las Vegas home services</p>
        <h1 id="hero-heading" data-intro class="mt-4 text-5xl leading-[0.95] tracking-wide text-white md:text-6xl xl:text-7xl">
          Repairs &amp; renovations for the house you're keeping.
        </h1>
        <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-white/75 md:text-xl" data-intro>
          Drywall, paint, flooring, plumbing, electrical, and the small jobs in
          between. One licensed Las Vegas crew, scheduled this week, not next month.
        </p>
        <p class="mt-8 text-[0.95rem] font-medium text-white/85" data-intro>
          {trust.join(" · ")}
        </p>
        <p class="mt-3 text-sm text-white/55" data-intro>
          Prefer to talk? <a href={`tel:${BUSINESS.phone.e164}`} class="font-medium text-white underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white">{BUSINESS.phone.display}</a>
        </p>
      </div>

      <div class="light rounded-2xl bg-white p-6 text-ink shadow-floating md:p-8" data-intro-card>
        <h2 class="font-heading text-2xl font-bold uppercase tracking-wide text-ink">Get a free quote</h2>
        <p class="mt-1 text-[0.95rem] text-body">Tell us about the work you need done.</p>
        <div class="mt-6"><HeroLeadForm idSuffix="hero" /></div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-intro-pending] [data-intro],
  [data-intro-pending] [data-intro-card] {
    opacity: 0;
  }
</style>

<script>
  import { animate, stagger } from "motion";
  const hero = document.querySelector<HTMLElement>("[data-hero][data-intro-pending]");
  if (hero) {
    const lines = hero.querySelectorAll<HTMLElement>("[data-intro]");
    const card = hero.querySelector<HTMLElement>("[data-intro-card]");
    const ease = [0.32, 0.72, 0, 1] as const;
    animate(lines, { opacity: [0, 1], y: [14, 0] }, { duration: 0.5, delay: stagger(0.07, { startDelay: 0.05 }), ease });
    if (card) animate(card, { opacity: [0, 1], y: [18, 0] }, { duration: 0.55, delay: 0.25, ease });
    window.setTimeout(() => hero.removeAttribute("data-intro-pending"), 900);
    try { sessionStorage.setItem("hw-intro", "1"); } catch {}
  }
</script>

